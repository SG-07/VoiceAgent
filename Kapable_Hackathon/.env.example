# Names only. Copy to .env.local and fill in real values. Never commit .env.local.

# Browser-safe (Vite exposes VITE_ variables to the client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (serverless functions and seed script). Never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Seed script demo passwords (choose your own; share with testers privately)
SEED_INSTRUCTOR_PASSWORD=
SEED_LEARNER_PASSWORD=
